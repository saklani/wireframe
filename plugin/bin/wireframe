#!/bin/sh
# wireframe for the Claude Code plugin. Plugin bin/ comes after the user's PATH,
# so a wireframe they installed themselves wins and this runs only when there is
# none: it fetches this platform's build from the latest release once per
# plugin version, then runs it.
set -e

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=aarch64-apple-darwin ;;
  Darwin-x86_64) target=x86_64-apple-darwin ;;
  Linux-x86_64) target=x86_64-unknown-linux-musl ;;
  Linux-aarch64 | Linux-arm64) target=aarch64-unknown-linux-musl ;;
  *)
    echo "wireframe: no prebuilt binary for $(uname -s) $(uname -m); build it with" \
      "cargo install --git https://github.com/saklani/wireframe" >&2
    exit 1
    ;;
esac

# The plugin's own folder is named for its version, so an update fetches anew.
version=$(basename "$(cd "$(dirname "$0")/.." && pwd)")
dir="${XDG_CACHE_HOME:-$HOME/.cache}/wireframe/$version"
bin="$dir/wireframe"

if [ ! -x "$bin" ]; then
  base="${WIREFRAME_DOWNLOAD:-https://github.com/saklani/wireframe/releases/latest/download}"
  mkdir -p "$dir"
  if ! curl -fsSL "$base/wireframe-$target" -o "$bin.$$"; then
    rm -f "$bin.$$"
    echo "wireframe: couldn't download $base/wireframe-$target; build it with" \
      "cargo install --git https://github.com/saklani/wireframe" >&2
    exit 1
  fi
  chmod +x "$bin.$$"
  mv "$bin.$$" "$bin"
fi

exec "$bin" "$@"
